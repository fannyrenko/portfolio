# Python bytecode files
*.pyc
*.pyo
__pycache__/

# Virtual environment directories
venv/
env/

# Logs and temporary files
*.log
*.tmp
*.bak

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE specific files (e.g., VS Code, PyCharm)
.vscode/
.idea/

# Groq-related files (if any)
groq_output/
groq_logs/

# Markdown output files
*.md

# HTML files (if you don't want them to be tracked)
*.htm

# Other files that may be generated during execution
matched_skills_*.md
